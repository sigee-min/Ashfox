{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ashfox.io/demos/schema.json",
  "title": "ashfox gallery demo",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "category",
    "tags",
    "featured",
    "order",
    "prompt",
    "description",
    "metrics",
    "project",
    "media",
    "agent"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "featured": { "type": "boolean" },
    "order": { "type": "integer", "minimum": 0 },
    "prompt": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bones", "cubes", "animations", "triangles", "glbPrimitives", "semanticEyes"],
      "properties": {
        "bones": { "type": "integer", "minimum": 0 },
        "cubes": { "type": "integer", "minimum": 0 },
        "animations": { "type": "integer", "minimum": 0 },
        "triangles": { "type": "integer", "minimum": 0 },
        "glbPrimitives": { "type": "integer", "minimum": 0 },
        "semanticEyes": { "type": "integer", "minimum": 0 }
      }
    },
    "project": { "$ref": "#/$defs/fileName" },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["poster", "animation"],
      "properties": {
        "poster": { "$ref": "#/$defs/fileName" },
        "build": { "$ref": "#/$defs/mediaSet" },
        "animation": { "$ref": "#/$defs/mediaSet" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reasoning"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "reasoning": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "fileName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "mediaSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gif", "alt"],
      "properties": {
        "gif": { "$ref": "#/$defs/fileName" },
        "video": { "$ref": "#/$defs/fileName" },
        "alt": { "type": "string", "minLength": 1 }
      }
    }
  }
}
