{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "@ashfox/blockbench-runtime/*": ["packages/blockbench-runtime/src/*"],
      "@ashfox/engine-core": ["packages/engine-core/src/index.ts"],
      "@ashfox/engine-core/*": ["packages/engine-core/src/*"],
      "@ashfox/blockbench-contracts/types": ["packages/blockbench-contracts/src/types/index.ts"],
      "@ashfox/blockbench-contracts/types/*": ["packages/blockbench-contracts/src/types/*"],
      "@ashfox/blockbench-contracts/mcpSchemas/*": ["packages/blockbench-contracts/src/mcpSchemas/*"],
      "@ashfox/blockbench-contracts/*": ["packages/blockbench-contracts/src/*"]
    },
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "types": ["node"],
    "lib": ["ES2020", "DOM"],
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "packages/blockbench-runtime/src/**/*",
    "packages/engine-core/src/**/*",
    "packages/blockbench-contracts/src/**/*",
    "apps/blockbench-plugin/src/**/*",
    "apps/blockbench-mcp-sidecar/src/**/*"
  ]
}
